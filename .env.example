APP_NAME=BHCIS
APP_ENV=local
APP_KEY=
# Never deploy with debug enabled - it leaks stack traces, env vars and PHI
APP_DEBUG=false
APP_URL=http://localhost

# Encrypt session payloads (PHI-bearing sessions) at rest
SESSION_ENCRYPT=true
# Auto-detect HTTPS (null), or force true/false in a fixed environment
SESSION_SECURE_COOKIE=null
# Trust X-Forwarded-* only from these proxy IPs; use * behind Vercel/ngrok
TRUSTED_PROXIES=127.0.0.1,::1

# Required when seeding users in production; demo default is used otherwise
# INITIAL_USER_PASSWORD=

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bhcis
DB_USERNAME=root
DB_PASSWORD=

# Mail - Gmail SMTP (outgoing mail: OTP codes, notifications)
# Requires 2-Step Verification + a 16-character App Password from
# https://myaccount.google.com/apppasswords (never use your login password).
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=smtp.bhcis@gmail.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="smtp.bhcis@gmail.com"
MAIL_FROM_NAME="BHCIS Sta. Ana"

# PDF rendering (Browsershot/Puppeteer)
# Set only when Chrome or Chromium is not auto-detected by Browsershot.
# LARAVEL_PDF_CHROME_PATH=/usr/bin/google-chrome
# LARAVEL_PDF_NODE_BINARY=/usr/bin/node
